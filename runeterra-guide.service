[Unit]
Description=Runeterra Irelia Mirror Guide static site
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/exedev/runeterra-irelia-mirror-guide
ExecStart=/usr/bin/python3 /home/exedev/runeterra-irelia-mirror-guide/server.py
Restart=always
RestartSec=2
User=exedev
Group=exedev

[Install]
WantedBy=multi-user.target
